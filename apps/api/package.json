{
  "name": "@luqman/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed-researchers.ts && tsx scripts/seed-corpus.ts",
    "seed:researchers": "tsx scripts/seed-researchers.ts",
    "seed:corpus": "tsx scripts/seed-corpus.ts",
    "demo": "tsx scripts/demo-run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^7.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "@google/genai": "^0.3.0",
    "@scalekit-sdk/node": "^2.5.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "postgres": "^3.4.4",
    "tsx": "^4.7.2",
    "uuid": "^9.0.1",
    "viem": "^2.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.21.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}

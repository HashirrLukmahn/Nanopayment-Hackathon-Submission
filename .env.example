# ──────────────────────────────────────────────────────────────────────────
# Luqman — environment variables
# Copy this file to `.env` and fill in the blanks. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (docker-compose). For Supabase/Neon, replace with your pooled connection.
DATABASE_URL=postgres://luqman:luqman@localhost:5432/luqman
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Circle ────────────────────────────────────────────────────────────────
# From https://console.circle.com (Developer-Controlled Wallets)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# Set automatically by create-wallet.ts after wallet creation
CIRCLE_WALLET_ADDRESS=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_BLOCKCHAIN=
# Arc testnet — set by Circle hackathon docs
ARC_RPC_URL=https://testnet-rpc.arc.network
ARC_EXPLORER_URL=https://explorer.arc.network
# The Circle wallet that pays out on behalf of agents during the demo.
# Fund from https://faucet.circle.com before running seed scripts.
LUQMAN_FAUCET_WALLET_ID=

# ── Gemini ────────────────────────────────────────────────────────────────
# Google AI Studio — https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Auth (Scalekit) ───────────────────────────────────────────────────────
# From https://app.scalekit.com
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=

# ── API access ────────────────────────────────────────────────────────────
ALLOW_API_KEY=

# ── Deployed contracts (set after `forge script Deploy.s.sol`) ────────────
LUQMAN_ATTRIBUTION_ADDRESS=
LUQMAN_TREASURY_ADDRESS=

# ── App URLs ──────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.network

# ── Pricing (tune as you like — in USDC) ──────────────────────────────────
PRICE_PER_CHUNK_USDC=0.008
RESEARCHER_SHARE_BPS=8500
PLATFORM_SHARE_BPS=1500

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
NANOPAYMENTS_MODE=
